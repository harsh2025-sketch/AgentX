# Normalise line endings so Windows and POSIX checkouts produce identical
# repository content. Text files are stored with LF in the repository and
# checked out with LF everywhere unless overridden below.
* text=auto eol=lf

# Windows-native script formats require CRLF to run reliably.
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary assets: never normalise.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.whl binary
